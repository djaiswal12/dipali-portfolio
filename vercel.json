{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,

  "redirects": [
    { "source": "/resume", "destination": "/about", "permanent": false },
    { "source": "/cv", "destination": "/about", "permanent": false }
  ],

  "rewrites": [
    { "source": "/((?!api/|images/|videos/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "_comment": "The three hand-maintained scripts live at fixed URLs, so a week-long hard cache means a bug fix in any of them stays invisible to returning visitors for a week after it ships — which is exactly what happened with the image-slot touch-scroll fix. They are small and served with an ETag, so revalidating costs a 304.",
      "source": "/(support|image-slot|video-slot).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|svg|ico|png|jpg|webp|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
